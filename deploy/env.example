# /etc/autochess/env   (installare con: sudo install -m 600 deploy/env.example /etc/autochess/env)
#
# File di secret del server. mode 0600, owner root (letto da systemd via
# EnvironmentFile). NON committare la versione compilata. NIENTE di tutto
# questo deve finire nell'APK: l'app parla solo con Supabase Auth + Caddy.
#
# Formato: KEY=value  (una per riga, senza spazi attorno a =, senza virgolette
# salvo che il valore le contenga).

# URL del progetto Supabase, es. https://abcdefgh.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key di Supabase (Project Settings -> API -> service_role).
# Bypassa le RLS: il master/worker la usa per RILEGGERE profiles/owned_civs e
# per scrivere match_history. VIVE SOLO SU QUESTO SERVER.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...replace-me...

# Segreto HMAC con cui il master firma i match_token a vita breve che il
# worker verifica senza rifare la verifica del JWT.
# Generare con:  openssl rand -hex 32
# Lo stesso valore deve stare su master E worker: firma anche gli SPAWN_MATCH
# interni (campo spawn_sig).
MATCH_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Opzionale. A "1": il master declassa all'hero di default chi dichiara un eroe
# la cui civilta' non e' in owned_civs. Lasciare vuoto/0 finche' gli eroi non
# sono legati alla civilta' (oggi l'origin dell'hero e' solo la palette 3D).
MASTER_ENFORCE_ROSTER=0

# --- usato solo da deploy/backup-db.sh, non dal server di gioco ---
# Connection string diretta al Postgres di Supabase (Project Settings ->
# Database -> Connection string -> URI). Contiene la password del DB.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Destinazione backup su Hetzner Storage Box (rsync/scp).
# es. u123456@u123456.your-storagebox.de:/home/backups/autochess
BACKUP_SSH_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de:/home/backups/autochess
# porta SSH della Storage Box (Hetzner usa 23 per il servizio completo)
BACKUP_SSH_PORT=23
