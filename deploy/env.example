# /etc/autochess/env   (installare con: sudo install -m 600 deploy/env.example /etc/autochess/env)
#
# File di secret del server. mode 0600, owner root (letto da systemd via
# EnvironmentFile). NON committare la versione compilata. NIENTE di tutto questo
# deve finire nell'APK: l'app parla solo con accounts.google.com (consenso) e
# con Caddy (wss).
#
# Formato: KEY=value  (una per riga, senza spazi attorno a =, senza virgolette
# salvo che il valore le contenga).

# --- database (PostgREST sul loopback, mai esposto) ---
DB_API_URL=http://127.0.0.1:3000

# --- OAuth Google ---
# Client di tipo "Web application" (Google Cloud Console -> Credentials), NON
# "Desktop app": il redirect non torna piu' dentro l'app sul loopback ma su
# questo server. Su Android il loopback non puo' funzionare — appena si apre il
# browser l'app va in pausa e non accetta connessioni.
# Il client_secret sta solo qui e mai nell'APK: lo scambio del code lo fa il
# master (server/google_oauth.gd).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Deve stare, IDENTICO, fra gli "Authorized redirect URIs" del client OAuth e
# combaciare con la rotta `handle /oauth/cb` del Caddyfile.
GOOGLE_REDIRECT_URI=https://game.tuodominio.it/oauth/cb

# Opzionale. Package Android dell'app (export_presets.cfg -> package/unique_name):
# lo usa il pulsante "Torna ad AoA" della pagina di ritorno. Default:
# com.afalc.autochessofages
ANDROID_PACKAGE=com.afalc.autochessofages

# --- firme HMAC ---
# Token di SESSIONE emessi dal master dopo il login (server/session_token.gd).
# Generare con:  openssl rand -hex 32
SESSION_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Segreto con cui il master firma i match_token a vita breve che il worker
# verifica senza rifare la verifica del token di sessione. Firma anche gli
# SPAWN_MATCH interni (campo spawn_sig). Stesso valore su master E worker.
# Generare con:  openssl rand -hex 32
MATCH_TOKEN_SECRET=replace-with-openssl-rand-hex-32

# --- donazioni (Crowdfunding Store) ---
# Segreto condiviso col webhook di RevenueCat: nella dashboard va messo come
# header Authorization, con lo stesso valore esatto. Senza, il master rifiuta
# ogni webhook con 401 — e la barra delle donazioni resta ferma a zero.
# Generare con:  openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# Opzionale. A "1": il master declassa all'hero di default chi dichiara un eroe
# la cui civilta' non e' in owned_civs. Lasciare vuoto/0 finche' gli eroi non
# sono legati alla civilta' (oggi l'origin dell'hero e' solo la palette 3D).
MASTER_ENFORCE_ROSTER=0

# --- usato solo da deploy/backup-db.sh, non dal server di gioco ---
# Connessione diretta al Postgres locale per il pg_dump notturno.
BACKUP_DB_URL=postgresql://postgres@127.0.0.1:5432/autochess

# Destinazione backup su Hetzner Storage Box (rsync/scp).
BACKUP_SSH_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de:/home/backups/autochess
# porta SSH della Storage Box (Hetzner usa 23 per il servizio completo)
BACKUP_SSH_PORT=23
