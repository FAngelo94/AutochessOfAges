# /etc/caddy/Caddyfile
#
# TLS automatico via Let's Encrypt (Caddy lo gestisce da solo alla prima
# richiesta valida su :443). Sostituire il dominio con il proprio record A.
#
# WebSocket: Caddy v2 fa da proxy ai WebSocket in modo NATIVO tramite
# reverse_proxy — nessuna direttiva speciale, nessun blocco di header manuale
# per l'Upgrade. Basta indirizzare la route al backend.
#
# Le route sono STATICHE: un worker in piu' = un blocco in piu' qui
# (es. handle /ws/w2 { reverse_proxy 127.0.0.1:9002 }) + `systemctl enable --now
# autochess-worker@2`. Caddy NON viene ricaricato a ogni partita.
#
# TUTTE le route stanno in blocchi `handle`, DI PROPOSITO. Caddy v2 non valuta
# le direttive nell'ordine in cui sono scritte ma secondo un ordine interno
# fisso, in cui `respond` precede `reverse_proxy`: con direttive nude, il
# `respond ... 404` finale intercetterebbe anche /ws/mm e /ws/w1 (404 su tutto).
# I blocchi `handle` sono invece mutuamente esclusivi e in ordine di scrittura.

game.tuodominio.it {

	# --- master (matchmaking) ---
	handle /ws/mm {
		reverse_proxy 127.0.0.1:9000
	}

	# --- worker 1 (match autoritativo) ---
	handle /ws/w1 {
		reverse_proxy 127.0.0.1:9001
	}

	# --- worker 2: scommentare quando si aggiunge autochess-worker@2 ---
	# handle /ws/w2 {
	#	reverse_proxy 127.0.0.1:9002
	# }

	# --- redirect del login Google ---
	# Google redirige QUI dopo il consenso, non dentro l'app: sul telefono
	# l'app e' in pausa mentre il browser e' in primo piano e non potrebbe
	# ricevere niente. Il master scambia il code e tiene la sessione pronta
	# finche' il client non la ritira (server/oauth_http.gd).
	# Deve combaciare con GOOGLE_REDIRECT_URI in /etc/autochess/env e con gli
	# "Authorized redirect URIs" del client OAuth su Google Cloud.
	handle /oauth/cb {
		reverse_proxy 127.0.0.1:9010
	}

	# --- webhook delle donazioni (RevenueCat) ---
	# E' la SOLA scrittura di public.donations: il client non partecipa, perche'
	# la barra del Crowdfunding Store e' pubblica e un totale sommato da chi
	# paga sarebbe gonfiabile da chiunque. Stessa porta del redirect OAuth: il
	# master serve entrambe le rotte (server/oauth_http.gd).
	# Il master rifiuta la richiesta se l'header Authorization non combacia con
	# REVENUECAT_WEBHOOK_SECRET in /etc/autochess/env, quindi conoscere questo
	# indirizzo non basta per scrivere niente.
	handle /revenuecat/webhook {
		reverse_proxy 127.0.0.1:9010
	}

	# --- pagine statiche obbligatorie per il Play Store / GDPR ---
	# installare i file: sudo install -d /opt/autochess/www/it &&
	#   sudo cp deploy/www/*.html /opt/autochess/www/ &&
	#   sudo cp deploy/www/it/*.html /opt/autochess/www/it/
	# inglese di default, italiano sotto /it — personalizzare col proprio contatto.
	# inglese (default) a /..., italiano sotto /it/...
	@pages path / /privacy /termini /elimina-account /it /it/privacy /it/termini /it/elimina-account
	handle @pages {
		root * /opt/autochess/www
		try_files {path} {path}.html {path}/index.html index.html
		file_server
	}

	# hardening di base delle risposte
	header {
		# nasconde la versione del server
		-Server
		# no sniffing del content-type
		X-Content-Type-Options "nosniff"
		# niente framing di terze parti
		X-Frame-Options "DENY"
		# referrer minimo
		Referrer-Policy "no-referrer"
		# HSTS: 1 anno, subdomini inclusi
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# qualsiasi altra route non e' prevista: 404 secco.
	# `handle` senza matcher = catch-all, valutato solo se nessun handle
	# precedente ha gia' preso la richiesta.
	handle {
		respond "not found" 404
	}

	log {
		output file /var/log/caddy/game.access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
